generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 用户与认证 ───────────────────────────────

model User {
  id                 String    @id @default(cuid())
  uid                Int?      @unique
  username           String    @unique @db.VarChar(50)
  nickname           String?   @db.VarChar(50) // 显示昵称，与登录用户名分离
  email              String    @unique
  emailVerified      DateTime?
  passwordHash       String?
  registrationIp     String?   @db.VarChar(45) // 注册IP
  registrationRegion String?   @db.VarChar(100) // 注册地（省份）
  avatar             String?
  bio                String?   @db.Text
  teaAge             Int? // 茶龄（年）
  preferenceTags     String[] // 偏好标签
  level              Int       @default(0) // 0-4
  exp                Int       @default(0)
  karma              Int       @default(0)
  followerCount      Int       @default(0) // 粉丝数缓存
  followingCount     Int       @default(0) // 关注数缓存
  role               String    @default("user") // user | admin

  // 社交状态
  onlineStatus String @default("offline") // online | offline | busy
  creditScore  Int    @default(100)
  noShowCount  Int    @default(0)

  // 封禁
  banStatus String    @default("active") // active | banned
  bannedAt  DateTime?
  banReason String?   @db.Text

  // 禁言与警告
  muteStatus   String    @default("active") // active | muted
  mutedUntil   DateTime?
  muteReason   String?   @db.Text
  warningCount Int       @default(0)

  // 自动化账号（PRD F0）：cron 任务（auto-vote/auto-reply/auto-boost-new 等）
  // 只允许在此类账号中活动，不得冒用真人；其发帖/投票/回复不计入 DAU、
  // 留存、社区带与任何前台展示计数。真实用户与未来注册默认 false。
  isSynthetic Boolean @default(false)

  // Phase 3 社区带：参与匿名汇总需**明确同意**（PRD §4「用户数据默认私有」）。
  // 默认 false；撤回 = 改回 false，聚合时按当下值取数，不做历史快照。
  shareAggregate   Boolean   @default(false)
  shareConsentedAt DateTime?

  // 关联
  accounts              Account[]
  sessions              Session[]
  articles              Article[]
  comments              Comment[]
  likes                 Like[]
  votes                 Vote[]
  teaReviews            TeaReview[]
  favorites             Favorite[]
  notifications         Notification[]
  actions               UserAction[]
  followedArticles      FollowedArticle[]
  boardModerators       BoardModerator[]
  moderateActions       ModerateAction[]
  followers             UserFollow[]         @relation("UserFollowers")
  following             UserFollow[]         @relation("UserFollowing")
  teaCreated            Tea[]
  teaSessions           TeaSession[]
  sessionMessages       TeaSessionMessage[]
  tastingNotes          TastingNote[]
  sentInvitations       SessionInvitation[]  @relation("SentInvitations")
  receivedInvitations   SessionInvitation[]  @relation("ReceivedInvitations")
  sessionParticipations SessionParticipant[]
  reports               Report[]             @relation("UserReports")
  handledReports        Report[]             @relation("HandledReports")
  announcements         Announcement[]
  teaInventory          TeaInventoryItem[]
  teaWishes             TeaWishItem[]
  sentTradeRequests     TradeRequest[]       @relation("TradeRequester")
  receivedTradeRequests TradeRequest[]       @relation("TradeResponder")
  sentMessages          UserMessage[]        @relation("SentMessages")
  receivedMessages      UserMessage[]        @relation("ReceivedMessages")
  cellarItems           CellarItem[]
  cellarTastings        CellarTasting[]
  teaRequests           TeaRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([karma])
  @@index([banStatus])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── 茶品百科 ─────────────────────────────────

model Tea {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(200)
  brand            String   @db.VarChar(100) // 大益、下关、陈升号...
  year             Int
  batch            String?  @db.VarChar(50) // 批次号
  type             String   @db.VarChar(10) // raw | ripe
  originRegion     String?  @db.VarChar(100)
  weightSpec       String?  @db.VarChar(50) // 357g、200g...
  storageCondition String?  @db.VarChar(100)
  coverImage       String?
  gallery          Json? // 图片数组
  description      String?  @db.Text
  aliases          String[] // 别名，用于模糊匹配

  // ── 经典普洱策展（P2-R2）──
  isClassic  Boolean @default(false) // 入选"经典普洱"模块
  marketInfo Json?   // 东和行情快照 {skuId, name, price, unit, changePct, updatedAt}

  // P2-R21 品牌管理删除箱：软删除标记（null=正常；非空=在删除箱中，前台/后台列表均过滤）
  deletedAt DateTime?

  tastingNoteCount Int    @default(0) // 缓存品鉴笔记数
  avgRating        Float? // 综合评分（各维度平均）

  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])

  articles     Article[]
  teaSessions  TeaSession[]
  tastingNotes TastingNote[]
  cellarItems  CellarItem[]
  mergedFromRequests TeaRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand, year])
  @@index([tastingNoteCount])
  @@index([deletedAt])
  @@map("teas")
}

// ─── 品鉴笔记 ─────────────────────────────────

model TastingNote {
  id      String  @id @default(cuid())
  title   String  @db.VarChar(200)
  content String  @db.Text
  summary String? @db.VarChar(500)

  // 评分（各维度 1-5）
  appearance Int?
  color      Int?
  aroma      Int?
  taste      Int?
  aftertaste Int?

  brewMethod String? @db.VarChar(20)
  waterTemp  Int?
  teaWeight  String? @db.VarChar(20)
  steepCount Int?

  images    Json? // ["https://oss.../img1.jpg", ...]
  videoUrl  String? @db.VarChar(500) // 自动生成的轮播视频 URL
  source    String  @default("evernote") // evernote | manual | import
  sourceId  String? // Evernote GUID
  sourceUrl String? // 原文链接

  // ─── F1 结构化抽取（PRD v0.3 §5 Phase 1）────────────────────────────
  // 只抽原文确实提到的定性信息；未提及保持 NULL（禁止推测补全）。
  // 四维分值（香气/滋味/水路/体感）不从旧笔记推测，因此这里没有对应字段。
  stage          String? @db.VarChar(20) // 上升期 | 巅峰期 | 适饮期 | 走下坡
  deltaVsPrev    String? @db.VarChar(10) // 更好 | 差不多 | 更差
  descriptors    Json? // 描述词数组，每个词必须在原文中出现过
  grams          Float? // 投茶量（克）
  vessel         String? @db.VarChar(40) // 器具（盖碗/紫砂壶/…）
  extractionMeta Json? // 抽取元信息：模型、置信度、接地结果、复核标记

  teaId String
  tea   Tea    @relation(fields: [teaId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teaId, createdAt])
  @@index([sourceId])
  @@map("tasting_notes")
}

// ─── 论坛版块 ─────────────────────────────────

model Board {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(50)
  slug        String  @unique @db.VarChar(50)
  description String? @db.VarChar(200)
  icon        String?
  sortOrder   Int     @default(0)

  minKarma     Int       @default(0) // 发帖所需最低声望
  postCount    Int       @default(0) // 帖子数（含回帖）
  threadCount  Int       @default(0) // 主题数
  lastPostedAt DateTime?

  articles        Article[]
  moderators      BoardModerator[]
  moderateActions ModerateAction[]

  createdAt DateTime @default(now())

  @@map("boards")
}

// ── 品牌吧（P2-R13）：经典普洱品牌分吧配置，管理员可在后台编辑 ──
model BrandBar {
  id    String  @id @default(cuid())
  key   String  @unique @db.VarChar(50)
  label String  @db.VarChar(50) // 大益吧
  icon  String? @db.VarChar(10) // 🏷️
  logo  String? // 品牌 logo 图片 URL
  brands String[] // 该吧包含的品牌名
  sortOrder Int  @default(0)

  createdAt DateTime @default(now())

  @@map("brand_bars")
}

// ── 品牌主数据（P2-R14）：品牌实体，茶品通过 teas.brand 字符串唯一关联 ──
// 改名时事务同步 teas.brand 与 brand_bars.brands，保证一处改名全局生效。
model Brand {
  id          String  @id @default(cuid())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(500)
  icon        String? @db.VarChar(10)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())

  @@map("brands")
}

model BoardModerator {
  id         String    @id @default(cuid())
  boardId    String
  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String    @default("moderator") @db.VarChar(20) // moderator | deputy
  status     String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  appliedAt  DateTime  @default(now())
  approvedAt DateTime?
  approvedBy String? // admin ID who approved
  teaAge     Int? // declared tea experience (years)
  reason     String?   @db.Text // application statement

  @@unique([boardId, userId])
  @@index([status])
  @@map("board_moderators")
}

model ModerateAction {
  id          String    @id @default(cuid())
  boardId     String
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  articleId   String
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  requestedBy String
  requester   User      @relation(fields: [requestedBy], references: [id]) // deputy user
  approvedBy  String? // moderator ID who approved
  status      String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  reason      String?   @db.Text
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([boardId, status])
  @@map("moderate_actions")
}

// ─── 用户留言 ─────────────────────────────────

model UserMessage {
  id         String    @id @default(cuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String    @db.VarChar(2000)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([receiverId, readAt])
  @@index([senderId, createdAt])
  @@map("user_messages")
}

// ─── 内容系统 ─────────────────────────────────

model Article {
  id         String  @id @default(cuid())
  type       String  @db.VarChar(20) // article | tasting | discussion
  title      String  @db.VarChar(200)
  content    String  @db.Text
  summary    String? @db.VarChar(500)
  // tea-draft 审校修改率基线：AI/拼装产出的原版（{title,content,summary}），
  // 草稿创建时写入、adapt 成功后更新为 adapt 输出；人工审校只改 content/summary，
  // 永不触碰此列 → diff(aiOriginal, 现值) = 纯人类修改。
  aiOriginal Json?

  // 论坛字段
  boardId String?
  board   Board?  @relation(fields: [boardId], references: [id])

  isPinned      Boolean   @default(false)
  isEssence     Boolean   @default(false)
  essencedAt    DateTime?
  replyCount    Int       @default(0)
  lastRepliedAt DateTime?

  // 品鉴专属字段
  teaId         String?
  tea           Tea?    @relation(fields: [teaId], references: [id])
  tastingScores Json? // { appearance: 4, color: 5, aroma: 4, taste: 5, aftertaste: 4 }
  brewMethod    String? @db.VarChar(20) // 壶泡 | 盖碗 | 煮茶
  waterTemp     Int?
  teaWeight     String? @db.VarChar(20)
  steepCount    Int? // 耐泡度

  flair       String?   @db.VarChar(30) // 帖子标签
  tags        String[]
  status      String    @default("published") // draft | published | archived | pending_review | rejected
  visibility  String    @default("public") // public | private（仅作者/管理员可见）

  // ── F0 内容来源（PRD v0.3 §6/F0）─────────────────────────────────────
  // human | ai_from_notes | ai_autonomous。新帖由各写入管线显式赋值；
  // 存量帖由一次性回填脚本按 src/lib/content-origin.ts 的规则推断。
  // 可空只服务回填窗口，回填后全量非空；读取侧遇 NULL 一律按「不可进数据层」
  // 处理（originCanFeedDataLayer(null)===false），所以未回填期不会误放行。
  origin        String?  @db.VarChar(20)
  // ai_from_notes 必填：本帖所依据的站长原始品鉴笔记 id（TastingNote.id）。
  // 其余 origin 恒为空数组。Json 而非外键约束：草稿可能引用多条，且原始笔记
  // 被删时这里保留墓碑 id 即可，不做级联。
  originNoteIds String[] @default([])
  // 统一署名账号 id（F0：AI 内容只用一个带标注的账号发，不再多账号扮演真人）。
  // 可空：human 帖与回填窗口允许为空。
  postedAsAccountId String?
  // 人审记录：发布动作发生时的审核管理员与时间。AI 管线只写 draft，发布永远
  // 经过人工，所以 published 的 AI 帖这两列必须非空（由发布路径写入）。
  reviewedBy String?
  reviewedAt DateTime?
  // F0：全自动 AI 文章必须「附信息来源链接」。这里存可点击的原始出处
  // （URL 数组），前台渲染在来源标注旁。人工文章恒为空数组。
  sourceUrls String[] @default([])

  moderation  Json? // 审核结果 {categories,confidence,reason,source};pending_review 时写入
  moderatedBy String? // 审核管理员 id
  moderatedAt DateTime? // 人工审核时间
  // 草稿「退回」反馈（资讯草稿管线）：{category,reason,by,at}。
  // 与 moderation 严格分开——后者是机器内容安全判定，这是人工选题质量反馈，
  // 脚本侧据此推导下一轮检索/筛选规则。退回即写 status="rejected"，行保留作去重墓碑。
  reviewFeedback Json?
  viewCount   Int       @default(0)
  upvotes     Int       @default(0)
  downvotes   Int       @default(0)
  videoUrl    String?   @db.VarChar(500) // 视频 URL（≤3分钟）
  images      String[] // 图片库 URL 列表（按顺序）

  hotOverride  String? @db.VarChar(20) // pinned | demoted | null (热榜手动控制)
  hotSortOrder Int? // 手动排序权重（仅 pinned 帖使用）

  // P2-R5 经典普洱跟进帖"升级为正式帖"时间：非空 = 进入主 feed（首页），
  // NULL = 仅存在于茶品档案/经典普洱区，不进主 feed（跟进帖内容格式与
  // 普通帖差异大，避免占据首页信息流）
  promotedHomeAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  moderateActions ModerateAction[]
  comments        Comment[]
  likes           Like[]
  favorites       Favorite[]
  followedBy      FollowedArticle[]
  xhsPackages     XhsPackage[]
  views           ArticleView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, createdAt])
  @@index([boardId, isPinned, lastRepliedAt])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@map("articles")
}

// ─── 小红书引流发布包 ─────────────────────────────────

model XhsPackage {
  id        String   @id @default(cuid())
  articleId String   @unique
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  videoUrl  String   @db.VarChar(500)
  hookTitle String   @db.VarChar(200)
  caption   String   @db.Text
  tags      String[]
  status    String   @default("pending") // pending | posted
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@map("xhs_packages")
}

// ─── 互动系统 ─────────────────────────────────

model Comment {
  id          String    @id @default(cuid())
  content     String    @db.Text
  images      String[] // 评论图片 URL 列表
  status      String    @default("published") // published | pending_review | rejected
  moderation  Json? // 审核结果(同 Article.moderation);pending_review 时写入
  moderatedBy String? // 审核管理员 id
  moderatedAt DateTime? // 人工审核时间
  parentId    String?

  articleId     String?
  article       Article?     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tastingNoteId String?
  tastingNote   TastingNote? @relation(fields: [tastingNoteId], references: [id], onDelete: Cascade)
  parent        Comment?     @relation("CommentReplies", fields: [parentId], references: [id])
  replies       Comment[]    @relation("CommentReplies")

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  likesCount Int @default(0)
  upvotes    Int @default(0)
  downvotes  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, createdAt])
  @@map("comments")
}

model Like {
  id    String @id @default(cuid())
  type  String @db.VarChar(10) // article | comment
  refId String // articleId or commentId

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, type, refId])
  @@map("likes")
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  refId     String // article.id or comment.id
  value     Int // 1 = upvote, -1 = downvote
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, refId])
  @@index([refId])
  @@map("votes")
}

// ─── Follow 系统 ───────────────────────────────

model FollowedArticle {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@map("followed_articles")
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id])
  following   User     @relation("UserFollowing", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("user_follows")
}

model Favorite {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([articleId])
  @@map("favorites")
}

// ─── 经验值系统 ───────────────────────────────

model UserAction {
  id          String  @id @default(cuid())
  actionType  String  @db.VarChar(20) // login|post|comment|like|trade|tea_session
  expGained   Int     @default(0)
  referenceId String? // 关联的 article/comment/session ID

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("user_actions")
}

// ─── 通知系统 ───────────────────────────────

model Notification {
  id      String  @id @default(cuid())
  type    String  @db.VarChar(30) // reply | upvote | mention | system | essence
  content String  @db.Text
  link    String? @db.VarChar(500) // 跳转链接
  read    Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

// ─── 云喝茶（Phase 2 预留）─────────────────────

model TeaSession {
  id          String  @id @default(cuid())
  title       String  @db.VarChar(200)
  teaName     String  @db.VarChar(200)
  description String? @db.Text
  coverImage  String?
  brewMethod  String? @db.VarChar(20)
  waterTemp   Int?
  teaWeight   String? @db.VarChar(20)

  status           String @default("inviting") // inviting | confirmed | live | ended | expired | cancelled
  viewerCount      Int    @default(0)
  peakViewers      Int    @default(0)
  peakParticipants Int    @default(0)
  teaGiftsCount    Int    @default(0)
  steepCount       Int    @default(0)

  duration        Int? // 茶会时长（分钟）
  images          String[] // 图片 URL 数组，第一张为封面
  maxParticipants Int?

  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  publishedArticleId String? // 发布到论坛的 Article ID

  teaId String?
  tea   Tea?    @relation(fields: [teaId], references: [id])

  hostId String
  host   User   @relation(fields: [hostId], references: [id])

  messages     TeaSessionMessage[]
  gallery      TeaSessionGallery[]
  invitations  SessionInvitation[]
  participants SessionParticipant[]

  createdAt DateTime @default(now())

  @@index([status, scheduledAt])
  @@map("tea_sessions")
}

model TeaSessionMessage {
  id       String  @id @default(cuid())
  type     String  @db.VarChar(10) // text | image | brew_log | gift | system
  content  String? @db.Text
  imageUrl String?
  brewLog  Json?
  giftType String?

  sessionId String
  session   TeaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("tea_session_messages")
}

model TeaSessionGallery {
  id          String  @id @default(cuid())
  steepNumber Int
  imageUrl    String
  description String?

  sessionId String
  session   TeaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("tea_session_gallery")
}

// ─── 云喝茶邀请 ─────────────────────────────

model SessionInvitation {
  id          String    @id @default(cuid())
  sessionId   String
  inviterId   String
  inviteeId   String
  status      String    @default("pending") // pending | accepted | declined
  respondedAt DateTime?

  session TeaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inviter User       @relation("SentInvitations", fields: [inviterId], references: [id])
  invitee User       @relation("ReceivedInvitations", fields: [inviteeId], references: [id])

  createdAt DateTime @default(now())

  @@unique([sessionId, inviteeId])
